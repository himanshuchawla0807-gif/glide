{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glide",
  "version": "0.1.0",
  "identifier": "com.himanshu.glide.windows",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label":"main", "title":"Glide", "width":600, "height":540, "decorations":false, "transparent":true, "shadow":false, "resizable":false, "alwaysOnTop":true, "skipTaskbar":true, "visible":true, "center":true }],
    "security": { "csp":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active":false }
}

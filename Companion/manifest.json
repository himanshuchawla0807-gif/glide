{
  "manifest_version": 3,
  "name": "Glide Companion",
  "version": "1.3.0",
  "description": "Local Chrome profile pairing, suggestions and new tabs for Glide.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "history",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connect Glide"
  },
  "minimum_chrome_version": "120"
}